#!/usr/bin/env bash
# oikbas-finance — finds the right Python interpreter that has the package installed.
# Falls back from miniconda → /usr/bin/python3 → python3 in PATH.

set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PKG_DIR="$(dirname "$SCRIPT_DIR")"
SRC_DIR="$PKG_DIR/src"

find_python() {
    for candidate in /root/miniconda/bin/python3 python3 /usr/bin/python3; do
        if command -v "$candidate" >/dev/null 2>&1; then
            if "$candidate" -c "import sys; sys.path.insert(0, '$SRC_DIR'); import oikbas_finance" 2>/dev/null; then
                echo "$candidate"
                return 0
            fi
        fi
    done
    return 1
}

PY=$(find_python)
if [ -z "$PY" ]; then
    echo "ERROR: no Python interpreter can import oikbas_finance" >&2
    echo "Tried: /root/miniconda/bin/python3, python3, /usr/bin/python3" >&2
    echo "Run: pip install -e $PKG_DIR" >&2
    exit 1
fi

# Ensure src is on path even if package isn't pip-installed for this interpreter.
export PYTHONPATH="$SRC_DIR${PYTHONPATH:+:$PYTHONPATH}"
exec "$PY" -m oikbas_finance "$@"
